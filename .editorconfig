# Biome formats the web and computer code. This file exists so an editor
# doesn't fight it, or the Kotlin style, before the checks run.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
max_line_length = 88

[*.{kt,kts,xml,properties,md,toml,yml,yaml}]
indent_style = space
indent_size = 4

[*.{md,toml,yml,yaml}]
indent_size = 2

[*.bat]
end_of_line = crlf
