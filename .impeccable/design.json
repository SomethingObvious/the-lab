      "css": ".ds-send{width:56px;height:56px;position:relative;border:0;background:none;padding:0;display:grid;place-items:center;color:var(--primary,#5a2ee6);cursor:pointer}.ds-send>svg:first-child{transform:rotate(40deg);transition:transform .65s cubic-bezier(.3,1.4,.5,1)}.ds-send>svg:last-child{color:var(--on-primary,#fff)}.ds-send:active>svg:first-child{transform:rotate(80deg) scale(.9)}.ds-send:focus-visible{outline:3px solid var(--focus,#5a2ee6);outline-offset:2px}"
    },
    {
      "name": "Shortcut Chips",
      "kind": "chip",
      "refersTo": "chip-pink",
      "description": "Pastel pills cycling pink, mint, sun and lilac along the top of the tray.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">Battery and Disk</button><button class=\"ds-chip\">Screenshot</button><button class=\"ds-chip\">Empty the Trash</button><button class=\"ds-chip\">Timers</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap}.ds-chip{font-family:\"Roboto Flex\",Roboto,system-ui,sans-serif;min-height:40px;padding:4px 16px;border:0;border-radius:20px;font-size:14px;font-weight:650;font-stretch:102%;cursor:pointer;transition:border-radius .35s,transform .35s}.ds-chip:nth-child(4n+1){background:var(--pink,#ffc4ea);color:var(--on-pink,#5c0a45)}.ds-chip:nth-child(4n+2){background:var(--mint,#9ff0d3);color:var(--on-mint,#00382a)}.ds-chip:nth-child(4n+3){background:var(--sun,#ffd23f);color:var(--on-sun,#3a2700)}.ds-chip:nth-child(4n+4){background:var(--lilac,#ddd2ff);color:var(--on-lilac,#26106e)}.ds-chip:active{border-radius:10px;transform:scale(.96)}.ds-chip:focus-visible{outline:3px solid var(--focus,#5a2ee6);outline-offset:2px}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer-tray",
      "description": "The tray with the round attach button, the pill message field and send.",
      "html": "<div class=\"ds-tray\"><button class=\"ds-round\" aria-label=\"Attach\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"position:relative\"><path d=\"M12 5v14M5 12h14\"/></svg></button><textarea class=\"ds-field\" rows=\"1\" placeholder=\"Message your Mac\"></textarea></div>",
      "css": ".ds-tray{display:flex;gap:6px;align-items:flex-end;background:var(--surface-1,#ece5ff);border-radius:36px;padding:8px}.ds-round{width:52px;height:52px;flex:none;border:0;border-radius:26px;background:var(--surface,#fff);color:var(--ink,#1a1530);display:grid;place-items:center;cursor:pointer;transition:border-radius .35s}.ds-round:active{border-radius:16px}.ds-field{font-family:\"Roboto Flex\",Roboto,system-ui,sans-serif;flex:1;min-width:0;resize:none;border:0;border-radius:26px;background:var(--surface,#fff);color:var(--ink,#1a1530);padding:14px 18px;min-height:52px;font-size:16px;line-height:1.45;outline:none}.ds-field::placeholder{color:var(--faint,#6a6386)}.ds-field:focus-visible{box-shadow:inset 0 0 0 2px var(--focus,#5a2ee6)}"
    },
    {
      "name": "Approval Card",
      "kind": "card",
      "refersTo": "approval-card",
      "description": "Amber card with the waiting burst, the agent's sentence and a connected Deny and Allow pair.",
      "html": "<div class=\"ds-ask\"><div class=\"ds-ask-top\"><span class=\"ds-ask-mark\"><svg viewBox=\"0 0 100 100\" style=\"position:absolute;inset:0;width:100%;height:100%\"><path fill=\"currentColor\" d=\"M50.00 2.00L53.07 3.20L55.77 6.14L58.11 9.22L60.48 10.90L63.37 10.63L66.93 9.13L70.74 7.94L74.00 8.43L76.06 11.01L76.93 14.90L77.42 18.74L78.62 21.38L81.26 22.58L85.10 23.07L88.99 23.94L91.57 26.00L92.06 29.26L90.87 33.07L89.37 36.63L89.10 39.52L90.78 41.89L93.86 44.23L96.80 46.93L98.00 50.00L96.80 53.07L93.86 55.77L90.78 58.11L89.10 60.48L89.37 63.37L90.87 66.93L92.06 70.74L91.57 74.00L88.99 76.06L85.10 76.93L81.26 77.42L78.62 78.62L77.42 81.26L76.93 85.10L76.06 88.99L74.00 91.57L70.74 92.06L66.93 90.87L63.37 89.37L60.48 89.10L58.11 90.78L55.77 93.86L53.07 96.80L50.00 98.00L46.93 96.80L44.23 93.86L41.89 90.78L39.52 89.10L36.63 89.37L33.07 90.87L29.26 92.06L26.00 91.57L23.94 88.99L23.07 85.10L22.58 81.26L21.38 78.62L18.74 77.42L14.90 76.93L11.01 76.06L8.43 74.00L7.94 70.74L9.13 66.93L10.63 63.37L10.90 60.48L9.22 58.11L6.14 55.77L3.20 53.07L2.00 50.00L3.20 46.93L6.14 44.23L9.22 41.89L10.90 39.52L10.63 36.63L9.13 33.07L7.94 29.26L8.43 26.00L11.01 23.94L14.90 23.07L18.74 22.58L21.38 21.38L22.58 18.74L23.07 14.90L23.94 11.01L26.00 8.43L29.26 7.94L33.07 9.13L36.63 10.63L39.52 10.90L41.89 9.22L44.23 6.14L46.93 3.20Z\"/></svg><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"position:relative\"><path d=\"M12 3.5 5 6.5v5c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9v-5l-7-3z\"/><path d=\"M12 8v4.5M12 15.5v.5\"/></svg></span><h2>Wants to move 6 installers to the Trash</h2></div><div class=\"ds-ask-row\"><button class=\"ds-deny\">Deny</button><button class=\"ds-allow\">Allow</button></div></div>",
      "css": ".ds-ask{font-family:\"Roboto Flex\",Roboto,system-ui,sans-serif;background:var(--ask-c,#ffe8ad);color:var(--ink,#1a1530);border-radius:32px;padding:18px}.ds-ask-top{display:flex;gap:14px;align-items:center}.ds-ask-mark{width:56px;height:56px;flex:none;position:relative;display:grid;place-items:center;color:var(--wait-mark,#2b1c00)}.ds-ask-mark>svg:last-child{color:var(--on-wait-mark,#ffd23f)}.ds-ask h2{margin:0;font-size:22px;font-weight:750;font-stretch:104%;line-height:1.25;letter-spacing:-.01em}.ds-ask-row{display:flex;gap:3px;margin-top:14px}.ds-ask-row button{font-family:\"Roboto Flex\",Roboto,system-ui,sans-serif;flex:1;min-height:60px;border:0;font-size:16px;font-weight:750;font-stretch:106%;cursor:pointer;transition:flex-grow .45s,border-radius .45s}.ds-deny{background:var(--surface,#fff);color:var(--ink,#1a1530);border-radius:30px 10px 10px 30px}.ds-allow{flex:1.5!important;background:var(--primary,#5a2ee6);color:var(--on-primary,#fff);border-radius:10px 30px 30px 10px}.ds-ask-row button:active{flex-grow:2;border-radius:16px}.ds-ask-row button:focus-visible{outline:3px solid var(--focus,#5a2ee6);outline-offset:2px}"
    },
    {
      "name": "Working Toolbar",
      "kind": "custom",
      "refersTo": "toolbar",
      "description": "The floating pill while the agent works, with the morphing loader and Stop.",
      "html": "<div class=\"ds-now\"><span class=\"ds-loader\"><svg viewBox=\"0 0 100 100\" width=\"34\" height=\"34\"><path fill=\"currentColor\" d=\"M50.00 2.00L53.12 2.33L56.15 3.30L58.99 4.82L61.59 6.76L63.93 8.95L66.06 11.23L68.03 13.44L69.93 15.48L71.87 17.28L73.93 18.81L76.19 20.13L78.67 21.33L81.36 22.50L84.17 23.78L86.99 25.28L89.68 27.09L92.08 29.25L94.04 31.76L95.44 34.57L96.22 37.62L96.36 40.78L95.90 43.96L94.94 47.05L93.64 50.00L92.14 52.76L90.63 55.35L89.24 57.81L88.08 60.20L87.20 62.63L86.59 65.16L86.19 67.85L85.90 70.73L85.57 73.77L85.07 76.91L84.26 80.04L83.04 83.04L81.35 85.75L79.20 88.05L76.62 89.84L73.71 91.06L70.57 91.72L67.34 91.86L64.12 91.59L61.00 91.06L58.04 90.42L55.24 89.83L52.58 89.42L50.00 89.27L47.42 89.42L44.76 89.83L41.96 90.42L39.00 91.06L35.88 91.59L32.66 91.86L29.43 91.72L26.29 91.06L23.38 89.84L20.80 88.05L18.65 85.75L16.96 83.04L15.74 80.04L14.93 76.91L14.43 73.77L14.10 70.73L13.81 67.85L13.41 65.16L12.80 62.63L11.92 60.20L10.76 57.81L9.37 55.35L7.86 52.76L6.36 50.00L5.06 47.05L4.10 43.96L3.64 40.78L3.78 37.62L4.56 34.57L5.96 31.76L7.92 29.25L10.32 27.09L13.01 25.28L15.83 23.78L18.64 22.50L21.33 21.33L23.81 20.13L26.07 18.81L28.13 17.28L30.07 15.48L31.97 13.44L33.94 11.23L36.07 8.95L38.41 6.76L41.01 4.82L43.85 3.30L46.88 2.33Z\"/></svg></span><span class=\"ds-now-text\"><b>Check mounted disk images</b><small>Working for 0:07</small></span><button class=\"ds-stop\">Stop</button></div>",
      "css": ".ds-now{font-family:\"Roboto Flex\",Roboto,system-ui,sans-serif;display:flex;align-items:center;gap:12px;min-height:72px;padding:8px 8px 8px 10px;border-radius:36px;background:var(--toolbar,#1d1440);color:var(--on-toolbar,#f1ecff);box-shadow:0 10px 28px -10px rgb(20 8 60/.55),0 2px 6px -2px rgb(20 8 60/.3)}.ds-loader{width:52px;height:52px;flex:none;border-radius:50%;display:grid;place-items:center;background:var(--loader-bg,rgb(255 255 255/.12));color:var(--loader-fg,#9ff0d3)}.ds-now-text{flex:1;display:flex;flex-direction:column;line-height:1.2}.ds-now-text b{font-size:16px;font-weight:750;font-stretch:104%}.ds-now-text small{font-size:12px;font-weight:550;opacity:.78}.ds-stop{font-family:\"Roboto Flex\",Roboto,system-ui,sans-serif;min-height:56px;padding:0 16px;border:0;border-radius:28px;background:var(--fail,#c62828);color:var(--on-fail,#fff);font-size:14px;font-weight:750;cursor:pointer;transition:border-radius .35s}.ds-stop:active{border-radius:14px}.ds-stop:focus-visible{outline:3px solid var(--focus,#5a2ee6);outline-offset:2px}"
    },
    {
      "name": "Header Stats",
      "kind": "custom",
      "refersTo": "header",
      "description": "The violet header with the battery burst, disk pill and link cookie.",
      "html": "<div class=\"ds-head\"><h1>The Lab</h1><div class=\"ds-glance\"><span class=\"ds-stat ds-batt\"><svg viewBox=\"0 0 100 100\" style=\"position:absolute;inset:0;width:100%;height:100%\"><path fill=\"currentColor\" d=\"M50.00 2.00L53.07 3.20L55.77 6.14L58.11 9.22L60.48 10.90L63.37 10.63L66.93 9.13L70.74 7.94L74.00 8.43L76.06 11.01L76.93 14.90L77.42 18.74L78.62 21.38L81.26 22.58L85.10 23.07L88.99 23.94L91.57 26.00L92.06 29.26L90.87 33.07L89.37 36.63L89.10 39.52L90.78 41.89L93.86 44.23L96.80 46.93L98.00 50.00L96.80 53.07L93.86 55.77L90.78 58.11L89.10 60.48L89.37 63.37L90.87 66.93L92.06 70.74L91.57 74.00L88.99 76.06L85.10 76.93L81.26 77.42L78.62 78.62L77.42 81.26L76.93 85.10L76.06 88.99L74.00 91.57L70.74 92.06L66.93 90.87L63.37 89.37L60.48 89.10L58.11 90.78L55.77 93.86L53.07 96.80L50.00 98.00L46.93 96.80L44.23 93.86L41.89 90.78L39.52 89.10L36.63 89.37L33.07 90.87L29.26 92.06L26.00 91.57L23.94 88.99L23.07 85.10L22.58 81.26L21.38 78.62L18.74 77.42L14.90 76.93L11.01 76.06L8.43 74.00L7.94 70.74L9.13 66.93L10.63 63.37L10.90 60.48L9.22 58.11L6.14 55.77L3.20 53.07L2.00 50.00L3.20 46.93L6.14 44.23L9.22 41.89L10.90 39.52L10.63 36.63L9.13 33.07L7.94 29.26L8.43 26.00L11.01 23.94L14.90 23.07L18.74 22.58L21.38 21.38L22.58 18.74L23.07 14.90L23.94 11.01L26.00 8.43L29.26 7.94L33.07 9.13L36.63 10.63L39.52 10.90L41.89 9.22L44.23 6.14L46.93 3.20Z\"/></svg><span>82%<small>Charging</small></span></span><span class=\"ds-disk\"><b>214 GB free</b><small>of 995 GB</small><i><i></i></i></span><span class=\"ds-stat ds-link\"><svg viewBox=\"0 0 100 100\" style=\"position:absolute;inset:0;width:100%;height:100%\"><path fill=\"currentColor\" d=\"M50.00 2.00L53.10 2.67L56.00 4.46L58.58 6.85L60.94 9.16L63.30 10.83L65.90 11.61L68.93 11.62L72.33 11.33L75.84 11.33L79.07 12.12L81.61 13.96L83.25 16.75L84.06 20.13L84.41 23.60L84.81 26.74L85.77 29.35L87.55 31.48L90.07 33.40L92.90 35.44L95.42 37.83L97.01 40.65L97.34 43.77L96.41 46.96L94.65 50.00L92.70 52.80L91.20 55.42L90.57 58.07L90.84 60.94L91.