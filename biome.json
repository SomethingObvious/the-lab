{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"extends": ["./computer/app-lint.json"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!demos", "!.impeccable"],
		"ignoreUnknown": true
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["relay/**"],
			"javascript": {
				"globals": ["WebSocketPair", "WebSocketRequestResponsePair"]
			}
		},
		{
			"includes": ["computer/codex.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"conventions": [
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"match": "_?(.+)",
										"formats": [
											"camelCase",
											"PascalCase",
											"CONSTANT_CASE",
											"snake_case"
										]
									},
									{
										"selector": {
											"kind": "typeProperty"
										},
										"match": "_?(.+)",
										"formats": [
											"camelCase",
											"PascalCase",
											"CONSTANT_CASE",
											"snake_case"
										]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["computer/qr.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noBitwiseOperators": "off"
					}
				}
			}
		},
		{
			"includes": ["computer/config.ts"],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off"
					}
				}
			}
		},
		{
			"includes": ["iphone/check.mjs"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["iphone/Tests/engine.cjs"],
			"linter": {
				"rules": {
					"suspicious": {
						"useStrictMode": "off"
					}
				}
			}
		},
		{
			"includes": ["computer/setup.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					},
					"style": {
						"noProcessEnv": "off",
						"useExplicitLengthCheck": "off",
						"noCommonJs": "off"
					}
				}
			}
		}
	]
}
