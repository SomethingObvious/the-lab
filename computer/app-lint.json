{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 88
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"nursery": {
				"recommended": true,
				"noFloatingPromises": "off"
			},
			"suspicious": {
				"noImportCycles": "off",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["error", "warn"]
					}
				},
				"noReactSpecificProps": "off",
				"noMisplacedAssertion": "off",
				"noUnnecessaryConditions": "off"
			},
			"security": {
				"noSecrets": "off"
			},
			"correctness": {
				"useImportExtensions": "off",
				"noUnresolvedImports": "off",
				"noUndeclaredDependencies": "off",
				"noNodejsModules": "off",
				"useQwikValidLexicalScope": "off",
				"noSolidDestructuredProps": "off"
			},
			"performance": {
				"noImgElement": "off",
				"noJsxPropsBind": "off",
				"useSolidForComponent": "off",
				"noAwaitInLoops": "off",
				"useTopLevelRegex": "off",
				"noBarrelFile": "off",
				"noReExportAll": "off"
			},
			"complexity": {
				"noImportantStyles": "off",
				"noVoid": "off",
				"noExcessiveLinesPerFunction": "off",
				"noForEach": "off",
				"useLiteralKeys": "off",
				"useMaxParams": "off",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 30
					}
				}
			},
			"style": {
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["camelCase", "PascalCase", "kebab-case"]
					}
				},
				"useComponentExportOnlyModules": "off",
				"useBlockStatements": "off",
				"noTernary": "off",
				"noNestedTernary": "off",
				"noMagicNumbers": "off",
				"noJsxLiterals": "off",
				"noHexColors": "off",
				"noContinue": "off",
				"noIncrementDecrement": "off",
				"useExportsLast": "off",
				"noExcessiveLinesPerFile": "off",
				"noNegationElse": "off",
				"noImplicitBoolean": "off",
				"useDefaultSwitchClause": "off",
				"noDefaultExport": "off",
				"useDestructuring": "off",
				"noExcessiveClassesPerFile": "off",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"formats": ["camelCase", "PascalCase", "CONSTANT_CASE", "snake_case"]
							},
							{
								"selector": {
									"kind": "typeProperty"
								},
								"formats": ["camelCase", "PascalCase", "CONSTANT_CASE", "snake_case"]
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		},
		"globals": ["lab", "labNative"]
	}
}
